// File name: projects/02/ALU.hdl

/**
 * The ALU (Arithmetic Logic Unit).
 * Computes one of the following functions:
 * x+y, x-y, y-x, 0, 1, -1, x, y, -x, -y, !x, !y,
 * x+1, y+1, x-1, y-1, x&y, x|y on two 16-bit inputs, 
 * according to 6 input bits denoted zx,nx,zy,ny,f,no.
 * In addition, the ALU computes two 1-bit outputs:
 * if the ALU output == 0, zr is set to 1; otherwise zr is set to 0;
 * if the ALU output < 0, ng is set to 1; otherwise ng is set to 0.
 */

// Implementation: the ALU logic manipulates the x and y inputs
// and operates on the resulting values, as follows:
// if (zx == 1) set x = 0        // 16-bit constant
// if (nx == 1) set x = !x       // bitwise not
// if (zy == 1) set y = 0        // 16-bit constant
// if (ny == 1) set y = !y       // bitwise not
// if (f == 1)  set out = x + y  // integer 2's complement addition
// if (f == 0)  set out = x & y  // bitwise and
// if (no == 1) set out = !out   // bitwise not
// if (out == 0) set zr = 1
// if (out < 0) set ng = 1

CHIP ALU {
    IN  
        x[16], y[16],  // 16-bit inputs        
        zx, // zero the x input?
        nx, // negate the x input?
        zy, // zero the y input?
        ny, // negate the y input?
        f,  // compute out = x + y (if 1) or x & y (if 0)
        no; // negate the out output?

    OUT 
        out[16], // 16-bit output
        zr, // 1 if (out == 0), 0 otherwise
        ng; // 1 if (out < 0),  0 otherwise

    PARTS:
    // 【第一階段：處理 x 輸入】依 zx, nx 決定真正要運算的 x1
    // 若 zx=1，先把 x 清為 0；否則保留原 x
    Mux16(a=x, b=false, sel=zx, out=xZero);
    // 準備好反向版本 !xZero，供 nx 選擇
    Not16(in=xZero, out=xNot);
    // 若 nx=1，選 !x；否則選 xZero。結果叫 x1
    Mux16(a=xZero, b=xNot, sel=nx, out=x1);

    // 【第二階段：處理 y 輸入】同理，依 zy, ny 決定 y1
    Mux16(a=y, b=false, sel=zy, out=yZero);
    Not16(in=yZero, out=yNot);
    Mux16(a=yZero, b=yNot, sel=ny, out=y1);

    // 【第三階段：f 選擇運算】f=1 做加法，f=0 做 AND
    // 兩種都先算好，再用 Mux 選
    And16(a=x1, b=y1, out=xAndY);   // bitwise AND 版本
    Add16(a=x1, b=y1, out=xPlusY);  // 16-bit 加法版本
    Mux16(a=xAndY, b=xPlusY, sel=f, out=fOut);

    // 【第四階段：no 決定是否反向輸出】若 no=1，out = !fOut
    Not16(in=fOut, out=notFOut);
    Mux16(a=fOut, b=notFOut, sel=no, out=out);

    // 【第五階段：狀態旗標 zr, ng】
    // zr：out 全為 0 時為 1。用兩個 Or8Way 分段檢查再 OR 起來
    Or8Way(in=out[0..7], out=orLow);   // 低 8 位有任一 1 則為 1
    Or8Way(in=out[8..15], out=orHigh); // 高 8 位有任一 1 則為 1
    Or(a=orLow, b=orHigh, out=notZr);  // 16位中有任一1則為1
    Not(in=notZr, out=zr);             // 反向：全0時 zr=1
    // ng：二補數下最高位 out[15]=1 代表負數，直接取出
    And(a=out[15], b=true, out=ng);    // 用 AND(true) 當作導線，把 sign bit 複製到 ng
}